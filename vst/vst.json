{
  "name": "Keyscope",
  "vendor": "jacob-sabella",
  "uid": "KySc",
  "version": 1000,
  "so": "keyscope.so",
  "effect": true,
  "targets": [
    "armv7",
    "aarch64"
  ],
  "defines": {
    "PARAM_TEXT_MAX": 48
  },
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "build": {
    "root": "..",
    "sources": [
      "src/keyscope.c",
      "src/analyzer.c",
      "src/seq_in.c"
    ],
    "cflags": [
      "-Isrc"
    ],
    "libs": [
      "-lm",
      "-lpthread",
      "-ldl"
    ]
  },
  "sample_page": {
    "banks": [
      {
        "name": "KEY",
        "knobs": [
          "lock",
          "hold",
          "memory"
        ]
      },
      {
        "name": "SOUND",
        "knobs": [
          "source",
          "range",
          "gate"
        ]
      },
      {
        "name": "STYLE",
        "knobs": [
          "profile",
          "chords",
          "notation"
        ]
      }
    ],
    "lines": [
      {
        "key": "key_name",
        "size": 3,
        "color": "#ff2fa0"
      },
      {
        "key": "chord",
        "size": 2,
        "label": true,
        "color": "#22e6ff"
      },
      "key_info",
      "scale_notes",
      "tuning_read",
      "status"
    ],
    "fps": 10
  }
}
